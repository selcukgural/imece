// imece's first tour: what imece is. imece's real screen on the simulation
// (`imece --demo`, seed 7), served by ../serve.sh; rendered with PromoVideo
// (../README.md). Every claim in the narration is one the README and the
// docs make; the agents and their work are the simulation's.
//
// The simulation steps on the wall clock, so a key that lands later than
// planned sees a slightly different screen: the steps name what to show, not
// a row the viewer must find. Keys arrive at least every 18 seconds, since
// after 20 seconds without one the next key would open the away digest.
{
  "title": "imece — what it is",
  "language": "en",
  "baseUrl": "http://127.0.0.1:8791",
  "viewport": { "width": 1920, "height": 1080, "deviceScaleFactor": 1 },
  "output": { "width": 1920, "height": 1080, "fps": 30 },
  "colorScheme": "dark",
  "voice": {
    "provider": "google",
    "name": "Charon",
    "model": "gemini-2.5-pro-tts",
    "prompt": "Read in a calm, warm and clear product-tour voice, at a natural pace.",
    "rate": 1.0
  },
  "music": { "generate": "ambient", "volume": 0.15 },
  "pronounce": {
    "imece's": "imeje's",
    "imece": "imeje",
    "worktree": "work-tree",
    "worktrees": "work-trees"
  },
  "scenes": [
    {
      "id": "opening",
      "chapter": "imece",
      "minSeconds": 4.5,
      "steps": [
        { "action": "goto", "path": "/card.html?t=imece&s=One%20terminal%20for%20many%20coding%20agents" },
        { "action": "hover", "target": "#corner" }
      ]
    },
    {
      "id": "what",
      "chapter": "What imece is",
      "narration": "imece runs a team of Claude Code agents on one codebase, on one screen. A leader reads your checkout and hires workers as the work needs them; each worker changes a git worktree of its own, never your checkout.",
      "steps": [
        { "action": "goto", "path": "/" },
        { "action": "wait", "seconds": 2 },
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 6 },
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 5 }
      ]
    },
    {
      "id": "home",
      "chapter": "Home",
      "narration": "This is Home: one list. What is to decide comes first, grouped by what deciding costs you: permissions, questions, changes. Then who is at work, project by project. A worker's row is its card, the step of its own to-do list it is on, and dimmer, the tool call it is making; the mark in front says where it stands: at work, waiting for you, done, stuck. Capital J opens the journal in a window: what happened, card by card, and whom you hold up.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 7 },
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 7 },
        { "action": "type", "target": "#corner", "text": "J", "delayMs": 0 },
        { "action": "wait", "seconds": 8 },
        { "action": "press", "key": "Escape" },
        { "action": "wait", "seconds": 1 }
      ]
    },
    {
      "id": "deeper",
      "chapter": "Three depths",
      "narration": "Enter looks deeper: an agent's detail, with how full its context is, its to-do list step by step, and its card's story; tab turns to its diff and its conversation. Enter again shows the raw stream from Claude Code itself. Escape goes back. Three depths, everywhere: the list, one piece of work, the raw stream.",
      "steps": [
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 5 },
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 5 },
        { "action": "press", "key": "Escape" },
        { "action": "wait", "seconds": 1 },
        { "action": "press", "key": "Escape" }
      ]
    },
    {
      "id": "bus",
      "chapter": "Agents talk to each other",
      "narration": "Agents talk to each other over a bus: they ask, answer, hand work off, report progress, and say when they are blocked. imece reads only the envelope; the body is never interpreted. Let us speed the simulation up, let them work for a while, and pause it.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "+", "delayMs": 0 },
        { "action": "wait", "seconds": 2 },
        { "action": "type", "target": "#corner", "text": "++", "delayMs": 300 },
        { "action": "wait", "seconds": 5 },
        { "action": "type", "target": "#corner", "text": "---", "delayMs": 200 },
        { "action": "wait", "seconds": 3 },
        { "action": "type", "target": "#corner", "text": " ", "delayMs": 0 },
        { "action": "wait", "seconds": 2 }
      ]
    },
    {
      "id": "decide",
      "chapter": "To decide",
      "narration": "Everything that needs you is at the top of Home: TO DECIDE. A change a worker has finished, a command Claude Code would have asked you about, a question for you. Each row says the whole ask and ends with the keys that decide it; g d jumps to the first. The terminal's title counts them, so a tab in the background shows it too.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "gd", "delayMs": 200 },
        { "action": "wait", "seconds": 5 },
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 5 },
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 4 }
      ]
    },
    {
      "id": "change",
      "chapter": "A change",
      "narration": "g c goes to the first change waiting, under the commands and questions, and enter opens it. Its first line is the verdict: what ran on its tree, whether it stays inside its card's paths, whether it can be approved as it stands. Then what the worker's worktree holds since its last done: the files above the patch, then the diff itself. j and k scroll it; the brackets go from file to file.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "gc", "delayMs": 200 },
        { "action": "wait", "seconds": 2 },
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 6 },
        { "action": "type", "target": "#corner", "text": "jjjj", "delayMs": 400 },
        { "action": "wait", "seconds": 3 },
        { "action": "type", "target": "#corner", "text": "]", "delayMs": 0 },
        { "action": "wait", "seconds": 4 }
      ]
    },
    {
      "id": "apply",
      "chapter": "Apply or send it back",
      "narration": "a applies the change to your checkout, staged, for you to look over and commit, and Home moves on to the next row. r sends it back and opens the composer, so you say why. Git does its work on a thread of its own; the journal says when the change is in. Your checkout is the one place an agent never writes.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "a", "delayMs": 0 },
        { "action": "wait", "seconds": 7 },
        { "action": "type", "target": "#corner", "text": "k", "delayMs": 0 },
        { "action": "wait", "seconds": 6 }
      ]
    },
    {
      "id": "pot",
      "chapter": "One pot",
      "narration": "Let the simulation run again. The header has four things: the projects, what is to decide, one pot for the whole team, kept between runs, and the time. The pot's rate and how long it lasts are a colon budget away. On a narrow screen, the least wanted parts give way first.",
      "steps": [
        { "action": "press", "key": "Escape" },
        { "action": "wait", "seconds": 1 },
        { "action": "type", "target": "#corner", "text": " ", "delayMs": 0 },
        { "action": "wait", "seconds": 1 },
        { "action": "type", "target": "#corner", "text": "gw", "delayMs": 200 },
        { "action": "wait", "seconds": 8 },
        { "action": "type", "target": "#corner", "text": "j", "delayMs": 0 },
        { "action": "wait", "seconds": 6 }
      ]
    },
    {
      "id": "windows",
      "chapter": "The board, the code map, the timeline",
      "narration": "The board, the code map and the timeline are windows over Home. Colon board: the cards the leaders posted, who claimed which, what is done; an idle worker may claim a card on its own. Colon code: one row per file, and who holds which symbols. Colon timeline: one lane per agent over the last hour, each column what it did then: writing, reading, thinking, asking a teammate, waiting for you, stuck. The brackets make a column five seconds, half a minute or a minute. Escape closes a window.",
      "steps": [
        { "action": "type", "target": "#corner", "text": ":board", "delayMs": 90 },
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 7 },
        { "action": "press", "key": "Escape" },
        { "action": "type", "target": "#corner", "text": ":code", "delayMs": 90 },
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 6 },
        { "action": "press", "key": "Escape" },
        { "action": "type", "target": "#corner", "text": ":timeline", "delayMs": 90 },
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 8 },
        { "action": "type", "target": "#corner", "text": "]", "delayMs": 0 },
        { "action": "wait", "seconds": 5 },
        { "action": "press", "key": "Escape" },
        { "action": "wait", "seconds": 1 }
      ]
    },
    {
      "id": "talk",
      "chapter": "You talk to the leader",
      "narration": "You talk to the leader, not to thirty agents. Type what you want; the leader turns it into cards, and the workers take them from the board. The reply comes back as something waiting for you.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "/", "delayMs": 0 },
        { "action": "wait", "seconds": 1 },
        { "action": "type", "target": "#corner", "text": "rate limiting on the public API, with tests", "delayMs": 70 },
        { "action": "press", "key": "Enter" },
        { "action": "wait", "seconds": 6 }
      ]
    },
    {
      "id": "quit",
      "chapter": "Quitting, and coming back",
      "narration": "q asks before quitting: how many agents are mid-turn, how many changes you have not reviewed. s lists them. Everything imece knows is kept in one SQLite file; the next imece opens on the same screen, every agent asleep until you write to one.",
      "steps": [
        { "action": "type", "target": "#corner", "text": "q", "delayMs": 0 },
        { "action": "wait", "seconds": 5 },
        { "action": "type", "target": "#corner", "text": "s", "delayMs": 0 },
        { "action": "wait", "seconds": 7 },
        { "action": "press", "key": "Escape" }
      ]
    },
    {
      "id": "closing",
      "chapter": "Learn more",
      "narration": "imece is open source. Install it with one line, and try the simulation for free.",
      "tail": 1.5,
      "steps": [
        { "action": "card", "title": "imece", "text": "github.com/selcukgural/imece" },
        { "action": "wait", "seconds": 3 }
      ]
    }
  ]
}
