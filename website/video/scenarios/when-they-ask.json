    {
      "id": "intro",
      "narration": "Agents ask you things. Here is how you answer, without leaving the keyboard.",
      "leadIn": 0.3,
      "tail": 0.4,
      "minSeconds": 13.2,
      "steps": [
        {
          "action": "press",
          "key": "ArrowDown"
