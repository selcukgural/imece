# SCR-15 · Writing: words and files in a list above the line.
start
see any key: close
key Escape
# A line sent: its words come back in the list.
type :why counter_total_rows
key Enter
key /
type and coun
see counter_total_rows
see tab take · ↓ choose · esc close
# Moved to, enter takes the word and sends nothing.
key Down
see enter take · ↑↓ choose · esc close
key Enter
see and counter_total_rows
gone esc close
# A file by its name (a word with a dot lists the files that hold it),
# taken with nothing after it.
type  shelf.
see test_shelf.py
key Tab
see and counter_total_rows shelf.py
gone tab take
# esc closes the list for that word; another letter keeps it closed.
type  coun
see tab take · ↓ choose · esc close
key Escape
gone tab take
type t
gone tab take
# A name from the checkout's code, never said.
key C-u
type and datac
see dataclass
# Mid-line: the word ending at the cursor, what follows it kept.
key C-u
type see  later
key Left Left Left Left Left Left
gone tab take
type coun
see tab take · ↓ choose · esc close
key Tab
see see counter_total_rows later
gone tab take
# On the second line of a text, writing opens the list too.
key C-e C-u
type first\
key Enter
type coun
see tab take · ↓ choose · esc close
key Tab
gone tab take
key Escape Escape
