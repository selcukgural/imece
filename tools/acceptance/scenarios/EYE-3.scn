# EYE-3 · The themes: `T` goes through every one, each scheme draws the
# whole screen in its own background, and the theme chosen last is the
# one the next start draws with.
start
see any key: close
key Escape
# Something on the screen: a change waiting.
key /
type mend shelf.py
key Enter
key Escape Escape
see run .imece/worktree-setup.sh
key g d
key a
see run .imece/check on its
key g d
key a
see 1 ready to approve
# The first is the terminal's own: `T` goes on from it, round to it again.
key T
see theme: dark
look dark.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py has dark.txt '1 ready to approve'
key T
see theme: light
look light.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py has light.txt '1 ready to approve'
key T
see theme: mono
look mono.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py has mono.txt '1 ready to approve'
key T
see theme: dracula
look dracula.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed dracula.txt
key T
see theme: nord
look nord.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed nord.txt
key T
see theme: gruvbox-dark-medium
look gruvbox-dark-medium.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed gruvbox-dark-medium.txt
key T
