sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed catppuccin-latte.txt
key T
see theme: tokyo-night-dark
look tokyo-night-dark.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed tokyo-night-dark.txt
key T
see theme: solarized-dark
look solarized-dark.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed solarized-dark.txt
key T
see theme: solarized-light
look solarized-light.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed solarized-light.txt
key T
see theme: onedark
look onedark.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed onedark.txt
key T
see theme: rose-pine
look rose-pine.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed rose-pine.txt
key T
see theme: everforest
look everforest.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed everforest.txt
key T
see theme: kanagawa
look kanagawa.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed kanagawa.txt
key T
see theme: github
look github.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed github.txt
key T
see theme: monokai
look monokai.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed monokai.txt
key T
see theme: terminal
look terminal.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py has terminal.txt '1 ready to approve'
# One kept: the next start draws with it.
type :theme nord
key Enter
see theme: nord
look before.txt
type :quit
key Enter
see quit imece?
key q
see Pane is dead
stop
start
see WHERE YOU LEFT OFF
key Escape
see 1 ready to approve
look after.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py samebg before.txt after.txt
sh python3 -I $ACC_SOURCE/tools/acceptance/eye.py themed after.txt
